# Core
DATABASE_URL=postgres://user:password@localhost:5432/bizkit
JWT_SECRET=replace-with-at-least-32-random-characters
APP_BASE_URL=http://localhost:5000

# Protected database bootstrap (required for POST /api/init-db in production)
DB_INIT_TOKEN=replace-with-a-long-random-token

# AI
HUGGINGFACE_API_KEY=
LMSTUDIO_API_URL=
LMSTUDIO_MODEL=local-model

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional server-side admin provisioning.
# Public signup never grants admin. Set both values in the server environment,
# then call POST /api/init-db (production also requires DB_INIT_TOKEN).
# If this email already exists as a non-admin, it is not elevated.
SUPER_USER_EMAIL=
SUPER_USER_PASSWORD=

# Set only in Replit Secrets or the deployment environment. Do not commit a value.
ADMIN_SECRET=

# Anonymous free-generation limit is stored on the server, keyed by client address.
# Set TRUST_PROXY=1 only when the app sits behind one trusted reverse proxy.
TRUST_PROXY=
# Optional HMAC salt for stored addresses. Defaults to JWT_SECRET or SESSION_SECRET.
QUOTA_IP_SALT=
