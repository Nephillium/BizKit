# Core
DATABASE_URL=postgres://user:password@localhost:5432/bizkit
JWT_SECRET=replace-with-at-least-32-random-characters
APP_BASE_URL=http://localhost:5000

# Protected database bootstrap (required for POST /api/init-db in production)
DB_INIT_TOKEN=replace-with-a-long-random-token

# AI
HUGGINGFACE_API_KEY=
LMSTUDIO_API_URL=
LMSTUDIO_MODEL=local-model

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional server-side admin provisioning.
# Public signup never grants admin. Set both values in the server environment,
# then call POST /api/init-db (production also requires DB_INIT_TOKEN).
# If this email already exists as a non-admin, it is not elevated.
# SUPER_USER_PASSWORD is read only when init-db first creates the admin.
# After that account exists, remove the password from secrets.
# Keep SUPER_USER_EMAIL so public signup keeps rejecting that address.
SUPER_USER_EMAIL=
SUPER_USER_PASSWORD=

# ADMIN_SECRET is unused legacy configuration. The application does not read it.
# Do not set it. Do not reuse any older value found in git history.

# Anonymous free-generation limit is stored on the server, keyed by client address.
# Set TRUST_PROXY=1 when the app sits behind exactly one trusted reverse proxy
# (for example Vercel, Render, or a single Nginx hop). That setting uses the
# rightmost X-Forwarded-For address, the hop that proxy appended.
# Leave it empty when the app is reached directly, or when more than one proxy
# appends to the header.
TRUST_PROXY=
# Set this explicitly. If it is empty, the HMAC falls back to JWT_SECRET, then
# SESSION_SECRET, and rotating JWT_SECRET resets anonymous quotas.
QUOTA_IP_SALT=
