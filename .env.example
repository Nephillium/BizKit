# Copy to .env. Never commit .env.
#
# Demo (local): DATABASE_URL is required. Leave the AI and Stripe keys empty.
# Production: set every variable in the "Production" section that you use,
# plus DATABASE_URL, JWT_SECRET, and APP_BASE_URL.

# --- Demo (required) ---
# Matches docker-compose.yml. Local only. Use a real password in production.
DATABASE_URL=postgres://bizkit:bizkit@localhost:5432/bizkit

# Dev falls back to an insecure secret when this is empty.
# Production requires 32+ random characters and rejects the placeholder below.
JWT_SECRET=
APP_BASE_URL=http://localhost:5000

# --- Demo AI (leave empty for sample output) ---
# Demo mode turns on when both AI variables are empty, or when DEMO_MODE=1.
# DEMO_MODE=1 forces sample output even if a provider key is set.
DEMO_MODE=
HUGGINGFACE_API_KEY=
LMSTUDIO_API_URL=
LMSTUDIO_MODEL=local-model

# npm run db:seed creates this user with credits. The seed refuses NODE_ENV=production.
# Defaults: demo@bizkit.local / demo-only-password / 25 credits. Role is always "user".
DEMO_USER_EMAIL=demo@bizkit.local
DEMO_USER_PASSWORD=demo-only-password
DEMO_USER_CREDITS=25

# Credits for accounts registered while NODE_ENV is not production. Ignored in production.
DEMO_SIGNUP_CREDITS=5

# --- Production ---
# Required to call POST /api/init-db in production.
DB_INIT_TOKEN=

# Required together for live credit purchases. Leave empty in the demo.
# Checkout stays disabled, with a message, when STRIPE_SECRET_KEY is missing.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional admin provisioning. Public signup never grants admin.
# Set both, then call POST /api/init-db (production also requires DB_INIT_TOKEN).
# An existing non-admin with this email is not elevated.
# After the admin row exists, remove SUPER_USER_PASSWORD. Keep SUPER_USER_EMAIL.
SUPER_USER_EMAIL=
SUPER_USER_PASSWORD=

# ADMIN_SECRET is unused. Do not set it.

# Set TRUST_PROXY=1 only behind exactly one trusted reverse proxy
# (Vercel, Render, or a single Nginx hop). Leave empty for local demo.
TRUST_PROXY=
# Own random value. If empty, the quota HMAC falls back to JWT_SECRET.
QUOTA_IP_SALT=
