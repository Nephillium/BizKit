# Copy to .env. Never commit .env.
#
# Demo (local): DATABASE_URL is required. Leave the AI and Stripe keys empty.
# Production: set every variable in the "Production" section that you use,
# plus DATABASE_URL, JWT_SECRET, and APP_BASE_URL.

# --- Demo (required) ---
# Matches docker-compose.yml. Local only. Use a real password in production.
DATABASE_URL=postgres://bizkit:bizkit@localhost:5432/bizkit

# Dev falls back to an insecure secret when this is empty.
# Production requires 32+ random characters and rejects the placeholder below.
JWT_SECRET=
APP_BASE_URL=http://localhost:5000

# Google sign-in. Leave both empty to hide "Continue with Google".
# One Web application OAuth client. Do not put an Android client secret here.
# Scopes are openid, email, and profile. Redirect URI is
# ${APP_BASE_URL}/api/auth/google/callback
# (https://pitchcrafter.glmlabs.io/api/auth/google/callback in production).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Demo AI (leave empty for sample output outside production) ---
# DEMO_MODE=1, true, or yes forces labelled samples even if a provider is set.
# Outside production, samples are also used when no provider is configured
# (AI_PROVIDER, OPENAI_API_KEY, HUGGINGFACE_API_KEY, and LMSTUDIO_API_URL all empty).
# In production, empty provider settings and DEMO_MODE unset make POST /api/generate
# return 503 and do not deduct credits. The private bizkit-demo preview sets DEMO_MODE=1.
DEMO_MODE=
OPENAI_API_KEY=
HUGGINGFACE_API_KEY=
LMSTUDIO_API_URL=
LMSTUDIO_MODEL=local-model

# Optional brand switch. Leave empty to use OpenAI when OPENAI_API_KEY is set,
# otherwise the historical default: LM Studio when LMSTUDIO_API_URL is set,
# otherwise Hugging Face (mistralai/Mistral-7B-Instruct-v0.3).
# AI_PROVIDER: openai, huggingface, lmstudio, or openai-compatible.
# AI_MODEL overrides the model id. openai defaults to gpt-5-mini and uses
# OPENAI_API_KEY. openai-compatible also needs AI_BASE_URL (chat-completions
# origin, no trailing path) and AI_API_KEY.
AI_PROVIDER=
AI_MODEL=
AI_BASE_URL=
AI_API_KEY=

# npm run db:seed creates this user with credits. The seed refuses NODE_ENV=production.
# Defaults: demo@bizkit.local / demo-only-password / 25 credits. Role is always "user".
DEMO_USER_EMAIL=demo@bizkit.local
DEMO_USER_PASSWORD=demo-only-password
DEMO_USER_CREDITS=25

# Credits for accounts registered while NODE_ENV is not production. Ignored in production.
DEMO_SIGNUP_CREDITS=5

# --- Production ---
# Required to call POST /api/init-db in production.
DB_INIT_TOKEN=

# Required together for live credit purchases. Leave empty in the demo.
# Checkout stays disabled, with a message, when STRIPE_SECRET_KEY is missing.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional admin provisioning. Public signup never grants admin.
# Set both, then call POST /api/init-db (production also requires DB_INIT_TOKEN).
# An existing non-admin with this email is not elevated.
# After the admin row exists, remove SUPER_USER_PASSWORD. Keep SUPER_USER_EMAIL.
SUPER_USER_EMAIL=
SUPER_USER_PASSWORD=

# ADMIN_SECRET is unused. Do not set it.

# Set TRUST_PROXY=1 only behind exactly one trusted reverse proxy
# (Vercel, Render, or a single Nginx hop). Leave empty for local demo.
TRUST_PROXY=
# Own random value. If empty, the quota HMAC falls back to JWT_SECRET.
QUOTA_IP_SALT=

# Bearer token for GET or POST /api/cron/retention.
# Generate with: openssl rand -hex 32
# Vercel Cron sends Authorization: Bearer $CRON_SECRET when this is set.
# Leave empty to keep the route closed. Never commit a real value.
CRON_SECRET=

# Set to 1, true, or yes to force the retention route to count rows and not delete them.
# Leave empty so the daily cron deletes.
RETENTION_DRY_RUN=
