# Origin of the PitchCrafter web app. No trailing slash.
# Expo inlines EXPO_PUBLIC_* when the mobile bundle is built.
# Local `expo start` uses this value, including localhost.
# EAS production and preview builds ignore a localhost value and default
# to https://pitchcrafter.glmlabs.io. Set a public origin in the EAS
# environment only when a release build should call a different host.
EXPO_PUBLIC_API_BASE_URL=http://localhost:5000

# Optional path to google-services.json for an EAS file environment variable.
# Do not commit the JSON. Analytics stays off when the file is absent.
# GOOGLE_SERVICES_JSON=
